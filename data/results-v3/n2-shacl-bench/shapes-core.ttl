@prefix o: <urn:oracle:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:oracle:shape:DOM%3AComponent.criticality> a sh:NodeShape ;
    sh:property <urn:oracle:shape:DOM%3AComponent.criticality/p> ;
    sh:targetClass <urn:oracle:type:Component> .

<urn:oracle:shape:DOM%3AComponent.mass> a sh:NodeShape ;
    sh:property <urn:oracle:shape:DOM%3AComponent.mass/p> ;
    sh:targetClass <urn:oracle:type:Component> .

<urn:oracle:shape:DOM%3AComponent.name> a sh:NodeShape ;
    sh:property <urn:oracle:shape:DOM%3AComponent.name/p> ;
    sh:targetClass <urn:oracle:type:Component> .

<urn:oracle:shape:DOM%3APort.direction> a sh:NodeShape ;
    sh:property <urn:oracle:shape:DOM%3APort.direction/p> ;
    sh:targetClass <urn:oracle:type:Port> .

<urn:oracle:shape:DOM%3ARequirement.name> a sh:NodeShape ;
    sh:property <urn:oracle:shape:DOM%3ARequirement.name/p> ;
    sh:targetClass <urn:oracle:type:Requirement> .

<urn:oracle:shape:DOM%3ARequirement.priority> a sh:NodeShape ;
    sh:property <urn:oracle:shape:DOM%3ARequirement.priority/p> ;
    sh:targetClass <urn:oracle:type:Requirement> .

<urn:oracle:shape:DOM%3AVerificationCase.method> a sh:NodeShape ;
    sh:property <urn:oracle:shape:DOM%3AVerificationCase.method/p> ;
    sh:targetClass <urn:oracle:type:VerificationCase> .

<urn:oracle:shape:ISO%3AComponent> a sh:NodeShape ;
    sh:or ( [ sh:minCount 1 ;
                sh:path [ sh:inversePath o:src ] ] [ sh:minCount 1 ;
                sh:path [ sh:inversePath o:tgt ] ] ) ;
    sh:targetClass <urn:oracle:type:Component> .

<urn:oracle:shape:ISO%3AFunction> a sh:NodeShape ;
    sh:or ( [ sh:minCount 1 ;
                sh:path [ sh:inversePath o:src ] ] [ sh:minCount 1 ;
                sh:path [ sh:inversePath o:tgt ] ] ) ;
    sh:targetClass <urn:oracle:type:Function> .

<urn:oracle:shape:ISO%3AInterface> a sh:NodeShape ;
    sh:or ( [ sh:minCount 1 ;
                sh:path [ sh:inversePath o:src ] ] [ sh:minCount 1 ;
                sh:path [ sh:inversePath o:tgt ] ] ) ;
    sh:targetClass <urn:oracle:type:Interface> .

<urn:oracle:shape:ISO%3APort> a sh:NodeShape ;
    sh:or ( [ sh:minCount 1 ;
                sh:path [ sh:inversePath o:src ] ] [ sh:minCount 1 ;
                sh:path [ sh:inversePath o:tgt ] ] ) ;
    sh:targetClass <urn:oracle:type:Port> .

<urn:oracle:shape:ISO%3ARequirement> a sh:NodeShape ;
    sh:or ( [ sh:minCount 1 ;
                sh:path [ sh:inversePath o:src ] ] [ sh:minCount 1 ;
                sh:path [ sh:inversePath o:tgt ] ] ) ;
    sh:targetClass <urn:oracle:type:Requirement> .

<urn:oracle:shape:ISO%3AVerificationCase> a sh:NodeShape ;
    sh:or ( [ sh:minCount 1 ;
                sh:path [ sh:inversePath o:src ] ] [ sh:minCount 1 ;
                sh:path [ sh:inversePath o:tgt ] ] ) ;
    sh:targetClass <urn:oracle:type:VerificationCase> .

<urn:oracle:shape:MULT%3AFunction%7Callocate%7Cout> a sh:NodeShape ;
    sh:property <urn:oracle:shape:MULT%3AFunction%7Callocate%7Cout/p> ;
    sh:targetClass <urn:oracle:type:Function> .

<urn:oracle:shape:MULT%3APort%7Ccontain%7Cin> a sh:NodeShape ;
    sh:property <urn:oracle:shape:MULT%3APort%7Ccontain%7Cin/p> ;
    sh:targetClass <urn:oracle:type:Port> .

<urn:oracle:shape:MULT%3ARequirement%7Csatisfy%7Cin> a sh:NodeShape ;
    sh:property <urn:oracle:shape:MULT%3ARequirement%7Csatisfy%7Cin/p> ;
    sh:targetClass <urn:oracle:type:Requirement> .

<urn:oracle:shape:MULT%3ARequirement%7Cverify%7Cin> a sh:NodeShape ;
    sh:property <urn:oracle:shape:MULT%3ARequirement%7Cverify%7Cin/p> ;
    sh:targetClass <urn:oracle:type:Requirement> .

<urn:oracle:shape:MULT%3AView%7Csubject%7Cout> a sh:NodeShape ;
    sh:property <urn:oracle:shape:MULT%3AView%7Csubject%7Cout/p> ;
    sh:targetClass <urn:oracle:type:View> .

<urn:oracle:shape:REQ%3AComponent.criticality> a sh:NodeShape ;
    sh:property <urn:oracle:shape:REQ%3AComponent.criticality/p> ;
    sh:targetClass <urn:oracle:type:Component> .

<urn:oracle:shape:REQ%3AComponent.mass> a sh:NodeShape ;
    sh:property <urn:oracle:shape:REQ%3AComponent.mass/p> ;
    sh:targetClass <urn:oracle:type:Component> .

<urn:oracle:shape:REQ%3AComponent.name> a sh:NodeShape ;
    sh:property <urn:oracle:shape:REQ%3AComponent.name/p> ;
    sh:targetClass <urn:oracle:type:Component> .

<urn:oracle:shape:REQ%3AFunction.name> a sh:NodeShape ;
    sh:property <urn:oracle:shape:REQ%3AFunction.name/p> ;
    sh:targetClass <urn:oracle:type:Function> .

<urn:oracle:shape:REQ%3AInterface.name> a sh:NodeShape ;
    sh:property <urn:oracle:shape:REQ%3AInterface.name/p> ;
    sh:targetClass <urn:oracle:type:Interface> .

<urn:oracle:shape:REQ%3APort.direction> a sh:NodeShape ;
    sh:property <urn:oracle:shape:REQ%3APort.direction/p> ;
    sh:targetClass <urn:oracle:type:Port> .

<urn:oracle:shape:REQ%3APort.name> a sh:NodeShape ;
    sh:property <urn:oracle:shape:REQ%3APort.name/p> ;
    sh:targetClass <urn:oracle:type:Port> .

<urn:oracle:shape:REQ%3ARequirement.name> a sh:NodeShape ;
    sh:property <urn:oracle:shape:REQ%3ARequirement.name/p> ;
    sh:targetClass <urn:oracle:type:Requirement> .

<urn:oracle:shape:REQ%3ARequirement.priority> a sh:NodeShape ;
    sh:property <urn:oracle:shape:REQ%3ARequirement.priority/p> ;
    sh:targetClass <urn:oracle:type:Requirement> .

<urn:oracle:shape:REQ%3AVerificationCase.method> a sh:NodeShape ;
    sh:property <urn:oracle:shape:REQ%3AVerificationCase.method/p> ;
    sh:targetClass <urn:oracle:type:VerificationCase> .

<urn:oracle:shape:REQ%3AVerificationCase.name> a sh:NodeShape ;
    sh:property <urn:oracle:shape:REQ%3AVerificationCase.name/p> ;
    sh:targetClass <urn:oracle:type:VerificationCase> .

<urn:oracle:shape:REQ%3AView.name> a sh:NodeShape ;
    sh:property <urn:oracle:shape:REQ%3AView.name/p> ;
    sh:targetClass <urn:oracle:type:View> .

<urn:oracle:shape:TYPE%3Aallocate> a sh:NodeShape ;
    sh:property <urn:oracle:shape:TYPE%3Aallocate/src>,
        <urn:oracle:shape:TYPE%3Aallocate/tgt> ;
    sh:targetClass <urn:oracle:edgetype:allocate> .

<urn:oracle:shape:TYPE%3Aconnect> a sh:NodeShape ;
    sh:property <urn:oracle:shape:TYPE%3Aconnect/src>,
        <urn:oracle:shape:TYPE%3Aconnect/tgt> ;
    sh:targetClass <urn:oracle:edgetype:connect> .

<urn:oracle:shape:TYPE%3Acontain> a sh:NodeShape ;
    sh:property <urn:oracle:shape:TYPE%3Acontain/src>,
        <urn:oracle:shape:TYPE%3Acontain/tgt> ;
    sh:targetClass <urn:oracle:edgetype:contain> .

<urn:oracle:shape:TYPE%3AdependOn> a sh:NodeShape ;
    sh:property <urn:oracle:shape:TYPE%3AdependOn/src>,
        <urn:oracle:shape:TYPE%3AdependOn/tgt> ;
    sh:targetClass <urn:oracle:edgetype:dependOn> .

<urn:oracle:shape:TYPE%3Aexpose> a sh:NodeShape ;
    sh:property <urn:oracle:shape:TYPE%3Aexpose/src>,
        <urn:oracle:shape:TYPE%3Aexpose/tgt> ;
    sh:targetClass <urn:oracle:edgetype:expose> .

<urn:oracle:shape:TYPE%3Asatisfy> a sh:NodeShape ;
    sh:property <urn:oracle:shape:TYPE%3Asatisfy/src>,
        <urn:oracle:shape:TYPE%3Asatisfy/tgt> ;
    sh:targetClass <urn:oracle:edgetype:satisfy> .

<urn:oracle:shape:TYPE%3Asubject> a sh:NodeShape ;
    sh:property <urn:oracle:shape:TYPE%3Asubject/src>,
        <urn:oracle:shape:TYPE%3Asubject/tgt> ;
    sh:targetClass <urn:oracle:edgetype:subject> .

<urn:oracle:shape:TYPE%3Averify> a sh:NodeShape ;
    sh:property <urn:oracle:shape:TYPE%3Averify/src>,
        <urn:oracle:shape:TYPE%3Averify/tgt> ;
    sh:targetClass <urn:oracle:edgetype:verify> .

<urn:oracle:shape:DOM%3AComponent.criticality/p> a sh:PropertyShape ;
    sh:in ( "A" "B" "C" "D" ) ;
    sh:path <urn:oracle:attr:criticality> .

<urn:oracle:shape:DOM%3AComponent.mass/p> a sh:PropertyShape ;
    sh:maxInclusive 10000 ;
    sh:minInclusive 0 ;
    sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) ;
    sh:path <urn:oracle:attr:mass> .

<urn:oracle:shape:DOM%3AComponent.name/p> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
    sh:path <urn:oracle:attr:name> .

<urn:oracle:shape:DOM%3APort.direction/p> a sh:PropertyShape ;
    sh:in ( "in" "out" ) ;
    sh:path <urn:oracle:attr:direction> .

<urn:oracle:shape:DOM%3ARequirement.name/p> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
    sh:path <urn:oracle:attr:name> .

<urn:oracle:shape:DOM%3ARequirement.priority/p> a sh:PropertyShape ;
    sh:in ( "high" "medium" "low" ) ;
    sh:path <urn:oracle:attr:priority> .

<urn:oracle:shape:DOM%3AVerificationCase.method/p> a sh:PropertyShape ;
    sh:in ( "test" "analysis" "inspection" "demonstration" ) ;
    sh:path <urn:oracle:attr:method> .

<urn:oracle:shape:MULT%3AFunction%7Callocate%7Cout/p> a sh:PropertyShape ;
    sh:path [ sh:inversePath o:src ] ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class <urn:oracle:edgetype:allocate> ] .

<urn:oracle:shape:MULT%3APort%7Ccontain%7Cin/p> a sh:PropertyShape ;
    sh:path [ sh:inversePath o:tgt ] ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class <urn:oracle:edgetype:contain> ] .

<urn:oracle:shape:MULT%3ARequirement%7Csatisfy%7Cin/p> a sh:PropertyShape ;
    sh:path [ sh:inversePath o:tgt ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class <urn:oracle:edgetype:satisfy> ] .

<urn:oracle:shape:MULT%3ARequirement%7Cverify%7Cin/p> a sh:PropertyShape ;
    sh:path [ sh:inversePath o:tgt ] ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class <urn:oracle:edgetype:verify> ] .

<urn:oracle:shape:MULT%3AView%7Csubject%7Cout/p> a sh:PropertyShape ;
    sh:path [ sh:inversePath o:src ] ;
    sh:qualifiedMaxCount 1 ;
    sh:qualifiedMinCount 1 ;
    sh:qualifiedValueShape [ sh:class <urn:oracle:edgetype:subject> ] .

<urn:oracle:shape:REQ%3AComponent.criticality/p> a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path <urn:oracle:attr:criticality> .

<urn:oracle:shape:REQ%3AComponent.mass/p> a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path <urn:oracle:attr:mass> .

<urn:oracle:shape:REQ%3AComponent.name/p> a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path <urn:oracle:attr:name> .

<urn:oracle:shape:REQ%3AFunction.name/p> a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path <urn:oracle:attr:name> .

<urn:oracle:shape:REQ%3AInterface.name/p> a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path <urn:oracle:attr:name> .

<urn:oracle:shape:REQ%3APort.direction/p> a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path <urn:oracle:attr:direction> .

<urn:oracle:shape:REQ%3APort.name/p> a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path <urn:oracle:attr:name> .

<urn:oracle:shape:REQ%3ARequirement.name/p> a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path <urn:oracle:attr:name> .

<urn:oracle:shape:REQ%3ARequirement.priority/p> a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path <urn:oracle:attr:priority> .

<urn:oracle:shape:REQ%3AVerificationCase.method/p> a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path <urn:oracle:attr:method> .

<urn:oracle:shape:REQ%3AVerificationCase.name/p> a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path <urn:oracle:attr:name> .

<urn:oracle:shape:REQ%3AView.name/p> a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path <urn:oracle:attr:name> .

<urn:oracle:shape:TYPE%3Aallocate/src> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:Function> ] ) ;
    sh:path o:src .

<urn:oracle:shape:TYPE%3Aallocate/tgt> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:Component> ] ) ;
    sh:path o:tgt .

<urn:oracle:shape:TYPE%3Aconnect/src> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:Port> ] ) ;
    sh:path o:src .

<urn:oracle:shape:TYPE%3Aconnect/tgt> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:Port> ] ) ;
    sh:path o:tgt .

<urn:oracle:shape:TYPE%3Acontain/src> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:Component> ] ) ;
    sh:path o:src .

<urn:oracle:shape:TYPE%3Acontain/tgt> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:Component> ] [ sh:class <urn:oracle:type:Port> ] ) ;
    sh:path o:tgt .

<urn:oracle:shape:TYPE%3AdependOn/src> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:Component> ] ) ;
    sh:path o:src .

<urn:oracle:shape:TYPE%3AdependOn/tgt> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:Component> ] ) ;
    sh:path o:tgt .

<urn:oracle:shape:TYPE%3Aexpose/src> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:View> ] ) ;
    sh:path o:src .

<urn:oracle:shape:TYPE%3Aexpose/tgt> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:Component> ] [ sh:class <urn:oracle:type:Port> ] ) ;
    sh:path o:tgt .

<urn:oracle:shape:TYPE%3Asatisfy/src> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:Component> ] ) ;
    sh:path o:src .

<urn:oracle:shape:TYPE%3Asatisfy/tgt> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:Requirement> ] ) ;
    sh:path o:tgt .

<urn:oracle:shape:TYPE%3Asubject/src> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:View> ] ) ;
    sh:path o:src .

<urn:oracle:shape:TYPE%3Asubject/tgt> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:Component> ] ) ;
    sh:path o:tgt .

<urn:oracle:shape:TYPE%3Averify/src> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:VerificationCase> ] ) ;
    sh:path o:src .

<urn:oracle:shape:TYPE%3Averify/tgt> a sh:PropertyShape ;
    sh:or ( [ sh:class <urn:oracle:type:Requirement> ] ) ;
    sh:path o:tgt .

